<!DOCTYPE html>
<html>
<head>
  <title><%= title %></title>
</head>
<body>

  <h1>Customer Information</h1>

  <!-- Traditional HTML form -->
  <form action="/readCustomerInfoAndRespond" method="POST">
    <label for="name">Name:</label>
    <input type="text" id="name" name="name" required>

    <br><br>

    <label for="email">Email:</label>
    <input type="email" id="email" name="email" required>

    <br><br>

    <!-- Traditional submission -->
    <button type="submit">Traditional Submit</button>

    <!-- REST/fetch submission -->
    <button type="button" id="submitBtn">REST Submit</button>
  </form>

  <div id="result"></div>

  <script>
    document.getElementById("submitBtn").addEventListener("click", async function () {
      const name = document.getElementById("name").value;
      const email = document.getElementById("email").value;
      const result = document.getElementById("result");

      try {
        const response = await fetch("/api/customer", {
          method: "POST",
          headers: {
            "Content-Type": "application/json"
          },
          body: JSON.stringify({
            name: name,
            email: email
          })
        });

        const data = await response.json();

        result.innerHTML =
          "<h2>REST/JSON Response</h2>" +
          "<p>" + data.message + "</p>" +
          "<p>" + data.email + "</p>";
      } catch (error) {
        result.innerHTML = "<p>An error occurred while sending the request.</p>";
      }
    });
  </script>

</body>
</html>